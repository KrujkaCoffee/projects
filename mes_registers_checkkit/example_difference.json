    },
    {
      "db": "BD_users",
      "sql": "WITH ranked_source AS (\n    SELECT\n        src.*,\n        ROW_NUMBER() OVER (PARTITION BY src.\"ФизическоеЛицо_Key\" ORDER BY julianday(src.\"Период\") DESC, src.\"id\" DESC) AS \"__register_rank\"\n    FROM \"КадроваяИстория\" AS src\n    WHERE julianday(src.\"Период\") <= julianday(?)\n),\nsource_state AS (\n    SELECT *\n    FROM ranked_source\n    WHERE \"__register_rank\" = 1\n)\nSELECT\n    src.\"id\" AS \"id\",\n    src.\"ФизическоеЛицо_Key\" AS \"ФизическоеЛицо_Key\",\n    src.\"Должность_Key\" AS \"Должность_Key\",\n    src.\"Подразделение_Key\" AS \"Подразделение_Key\",\n    src.\"Период\" AS \"Период\",\n    src.\"Организация_Key\" AS \"Организация_Key\",\n    src.\"Событие\" AS \"Событие\",\n    src.\"Сотрудник_Key\" AS \"Сотрудник_Key\",\n    src.\"id\" AS \"__register_source_0\",\n    src.\"Период\" AS \"__register_period_raw\"\nFROM source_state AS src\nORDER BY src.\"ФизическоеЛицо_Key\" ASC",
