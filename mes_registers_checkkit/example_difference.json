    {
      "db": "BD_users",
      "sql": "SELECT\n    src.\"id\" AS \"__register_source_0\",\n    src.\"Период\" AS \"__register_bad_period\"\nFROM \"КадроваяИстория\" AS src\nWHERE (src.\"Период\" IS NULL OR trim(CAST(src.\"Период\" AS TEXT)) = '' OR julianday(src.\"Период\") IS NULL OR date(src.\"Период\") <> substr(trim(CAST(src.\"Период\" AS TEXT)), 1, 10))\nLIMIT 1",
      "params": [],
