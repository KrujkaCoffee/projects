+/* Только оформление правил выбранной услуги; штатные стили не переопределяются. */
+.service-rules {
+    box-sizing: border-box;
+    margin: 2px 0 20px;
+    border: 1px solid #d7e2e9;
+    border-radius: 6px;
+    background: #fff;
+    color: #344b5d;
+    font-family: inherit;
+    font-size: 13px;
+    line-height: 1.5;
+    overflow-wrap: anywhere;
+}
+.service-rules[hidden] { display: none !important; }
+.service-rules-original-hidden,
+.service-executor-rules[hidden],
+.service-description-help[hidden] { display: none !important; }
+.service-rules--executor { padding: 16px 18px; }
+.service-rules__table { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 12px; }
+.service-rules__table th,
+.service-rules__table td { padding: 9px 8px; border: 1px solid #d7e2e9; text-align: left; vertical-align: top; overflow-wrap: anywhere; }
+.service-rules__table thead th { background: #eaf2f7; color: #29485f; }
+.service-rules__table th:first-child { width: 37%; }
+.service-rules__table tbody th { font-weight: 600; }
+.service-rules__requirement { display: block; margin-bottom: 4px; color: #29485f; }
+.service-description-help { margin: 0 0 10px; color: #536a7b; font-size: 13px; line-height: 1.45; }
+#service-form #description.service-description--template { min-height: 390px; }
+.service-rules .service-rules__section {
+    box-sizing: border-box;
+    margin: 0;
+    padding: 15px 18px;
+}
+.service-rules .service-rules__section + .service-rules__section {
+    border-top: 1px solid #e4ebf0;
+}
+.service-rules .service-rules__section--primary {
+    border-left: 3px solid #5293b8;
+    padding-left: 15px;
+    border-radius: 5px 5px 0 0;
+    background: #f7fbfd;
+}
+.service-rules .service-rules__section--notice { background: #fffaf0; }
+.service-rules .service-rules__title {
+    margin: 0 0 8px;
+    padding: 0;
+    color: #29485f;
+    font-family: inherit;
+    font-size: 15px;
+    font-weight: 600;
+    line-height: 1.35;
