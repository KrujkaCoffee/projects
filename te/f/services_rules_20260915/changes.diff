+.service-rules .service-rules__paragraph { margin: 0 0 8px; }
+.service-rules .service-rules__paragraph:last-child { margin-bottom: 0; }
+.service-rules .service-rules__list,
+.service-rules .service-rules__sublist { margin: 0; padding-left: 20px; list-style: disc outside; }
+.service-rules .service-rules__list > li,
+.service-rules .service-rules__sublist > li { margin: 0 0 5px; padding: 0; }
+.service-rules .service-rules__list > li:last-child,
+.service-rules .service-rules__sublist > li:last-child { margin-bottom: 0; }
+.service-rules .service-rules__sublist { margin-top: 6px; list-style-type: circle; }
+.service-rules .service-rules__section--details > summary {
+    display: list-item;
+    list-style: disclosure-closed inside;
+    cursor: pointer;
+    margin: 0;
+}
+.service-rules .service-rules__section--details[open] > summary {
+    list-style-type: disclosure-open;
+    margin-bottom: 12px;
+}
+.service-rules .service-rules__section--details > summary::marker { color: #5293b8; }
