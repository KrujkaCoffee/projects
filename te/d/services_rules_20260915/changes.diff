+/* Только оформление правил выбранной услуги; штатные стили не переопределяются. */
+.service-rules {
+    box-sizing: border-box;
+    margin: 2px 0 20px;
+    border: 1px solid #d7e2e9;
+    border-radius: 6px;
+    background: #fff;
+    color: #344b5d;
+    font-family: inherit;
+    font-size: 13px;
+    line-height: 1.5;
+    overflow-wrap: anywhere;
+}
+.service-rules[hidden] { display: none !important; }
+.service-rules-original-hidden,
+.service-executor-rules[hidden] { display: none !important; }
+.service-rules--executor { padding: 16px 18px; }
+.service-rules__table { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 12px; }
+.service-rules__table th,
+.service-rules__table td { padding: 9px 8px; border: 1px solid #d7e2e9; text-align: left; vertical-align: top; overflow-wrap: anywhere; }
+.service-rules__table thead th { background: #eaf2f7; color: #29485f; }
+.service-rules__table th:first-child { width: 37%; }
+.service-rules__table tbody th { font-weight: 600; }
+.service-rules__requirement { display: block; margin-bottom: 4px; color: #29485f; }
+.service-requirements { min-width: 0; margin: 0 0 24px; padding: 14px 18px 18px; border: 1px solid #d7e2e9; border-radius: 6px; background: #fbfdfe; color: #344b5d; font-size: 13px; }
+.service-requirements[hidden],
+.service-requirements [hidden] { display: none !important; }
+.service-requirements legend { padding: 0 7px; color: #29485f; font-size: 15px; font-weight: 600; }
+.service-requirements__intro { margin: 0 0 16px; color: #657b8c; font-size: 12px; }
+.service-requirements__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 18px 16px; }
+.service-requirements__field { min-width: 0; }
+.service-requirements__field--wide { grid-column: 1 / -1; }
+#service-form .service-requirements label { display: block; margin: 0 0 6px; color: #344b5d; font-size: 13px; }
