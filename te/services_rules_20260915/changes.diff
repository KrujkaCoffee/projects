+/* Только оформление правил выбранной услуги; штатные стили не переопределяются. */
+.service-rules {
+    box-sizing: border-box;
+    margin: 2px 0 20px;
+    border: 1px solid #d7e2e9;
+    border-radius: 6px;
+    background: #fff;
+    color: #344b5d;
+    font-family: inherit;
+    font-size: 13px;
+    line-height: 1.5;
+    overflow-wrap: anywhere;
+}
+.service-rules[hidden] { display: none !important; }
+.service-rules .service-rules__section {
+    box-sizing: border-box;
+    margin: 0;
+    padding: 15px 18px;
+}
+.service-rules .service-rules__section + .service-rules__section {
+    border-top: 1px solid #e4ebf0;
+}
+.service-rules .service-rules__section--primary {
+    border-left: 3px solid #5293b8;
+    padding-left: 15px;
+    border-radius: 5px 5px 0 0;
+    background: #f7fbfd;
+}
+.service-rules .service-rules__section--notice { background: #fffaf0; }
+.service-rules .service-rules__title {
+    margin: 0 0 8px;
+    padding: 0;
+    color: #29485f;
+    font-family: inherit;
+    font-size: 15px;
+    font-weight: 600;
+    line-height: 1.35;
+}
+.service-rules .service-rules__paragraph { margin: 0 0 8px; }
+.service-rules .service-rules__paragraph:last-child { margin-bottom: 0; }
+.service-rules .service-rules__list,
+.service-rules .service-rules__sublist { margin: 0; padding-left: 20px; list-style: disc outside; }
+.service-rules .service-rules__list > li,
+.service-rules .service-rules__sublist > li { margin: 0 0 5px; padding: 0; }
+.service-rules .service-rules__list > li:last-child,
+.service-rules .service-rules__sublist > li:last-child { margin-bottom: 0; }
+.service-rules .service-rules__sublist { margin-top: 6px; list-style-type: circle; }
+.service-rules .service-rules__section--details > summary {
+    display: list-item;
+    list-style: disclosure-closed inside;
+    cursor: pointer;
+    margin: 0;
+}
+.service-rules .service-rules__section--details[open] > summary {
+    list-style-type: disclosure-open;
+    margin-bottom: 12px;
+}
+.service-rules .service-rules__section--details > summary::marker { color: #5293b8; }
+.service-rules .service-rules__section--details > summary:hover { color: #1f6e9b; }
+.service-rules .service-rules__section--details > summary:focus-visible {
+    outline: 2px solid #5293b8;
+    outline-offset: 4px;
+    border-radius: 2px;
+}
+@media (max-width: 640px) {
+    .service-rules .service-rules__section { padding: 13px 14px; }
+    .service-rules .service-rules__section--primary { padding-left: 11px; }
+}
