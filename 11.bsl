
ИмяПользователя ="Баширова Зульфия Зуфаровна";
ИмяОтчета = "СтоимостьМатериаловИРаботСпецификации";

ПользовательИБ = Неопределено;

Для Каждого Пользователь Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл

	Если Пользователь.Имя = ИмяПользователя Тогда
		ПользовательИБ = Пользователь;
		Прервать;
	КонецЕсли;

КонецЦикла;

Если ПользовательИБ = Неопределено Тогда
	Сообщить("Пользователь не найден: " + ИмяПользователя);
	Возврат;
КонецЕсли;



МетаОтчет = Метаданные.Отчеты.Найти(ИмяОтчета);

Если МетаОтчет = Неопределено Тогда
	Сообщить("Отчет не найден: " + ИмяОтчета);
	Возврат;
КонецЕсли;


РолиПользователя = Новый Соответствие;

Для Каждого РольПользователя Из ПользовательИБ.Роли Цикл
	РолиПользователя.Вставить(РольПользователя.Имя, Истина);
КонецЦикла;


ПодходящиеРоли = Новый Массив;
НедостающиеРоли = Новый Массив;

Для Каждого Роль Из Метаданные.Роли Цикл

	ЕстьПросмотр = Ложь;
	ЕстьИспользование = Ложь;

	Попытка
		ЕстьПросмотр = ПравоДоступа(
			"Просмотр",
			МетаОтчет,
			Роль);
	Исключение

	КонецПопытки;

	Попытка
		ЕстьИспользование = ПравоДоступа(
			"Использование",
			МетаОтчет,
			Роль);
	Исключение

	КонецПопытки;


	Если ЕстьПросмотр Или ЕстьИспользование Тогда

		ПодходящиеРоли.Добавить(Роль.Имя);

		Если РолиПользователя.Получить(Роль.Имя) = Неопределено Тогда
			НедостающиеРоли.Добавить(Роль.Имя);
		КонецЕсли;

	КонецЕсли;

КонецЦикла;



Сообщить("");
Сообщить("Пользователь: " + ПользовательИБ.Имя);
Сообщить("Отчет: " + ИмяОтчета);

Сообщить("");
Сообщить("=== Роли, дающие доступ к отчету ===");

Для Каждого ИмяРоли Из ПодходящиеРоли Цикл

	Если РолиПользователя.Получить(ИмяРоли) <> Неопределено Тогда
		Сообщить("  [ЕСТЬ] " + ИмяРоли);
	Иначе
		Сообщить("  [НЕТ]  " + ИмяРоли);
	КонецЕсли;

КонецЦикла;


Сообщить("");
Сообщить("=== НЕДОСТАЮЩИЕ РОЛИ ===");

Если НедостающиеРоли.Количество() = 0 Тогда

	Сообщить("Недостающих ролей не найдено.");

Иначе

	Для Каждого ИмяРоли Из НедостающиеРоли Цикл
		Сообщить("  " + ИмяРоли);
	КонецЦикла;

КонецЕсли;

